<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_total_balance_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_blue"
    android:padding="16dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Saldo total"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#3B82F6"
            android:text="👁"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Main Amount -->
    <TextView
        android:id="@+id/widget_total_balance_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$ 24,850.75"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />

    <!-- Subtitle Currency -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MXN"
        android:textColor="#DBEAFE"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp" />

    <!-- Monthly Variation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/widget_total_balance_variation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▲ $2,350.40 (9.46%)"
            android:textColor="#4ADE80"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" vs. mes anterior"
            android:textColor="#E0E7FF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
