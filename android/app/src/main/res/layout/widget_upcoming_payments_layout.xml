<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_upcoming_container" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_surface_dark" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
        <TextView android:id="@+id/widget_upcoming_title" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Pagos próximos" android:textColor="#F8FAFC" android:textSize="12sp"
            android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PRÓXIMOS 30 DÍAS" android:textColor="#818CF8" android:textSize="8sp"
            android:textStyle="bold" android:layout_marginEnd="8dp" />
        <ImageView android:id="@+id/widget_eye_btn" android:layout_width="24dp"
            android:layout_height="24dp" android:padding="5dp"
            android:src="@drawable/ic_widget_eye" />
    </LinearLayout>
    <TextView android:id="@+id/widget_upcoming_payment1" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"
        android:background="@drawable/widget_panel_dark" android:paddingHorizontal="10dp"
        android:text="Sin pagos próximos" android:textColor="#F8FAFC" android:textSize="11sp"
        android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_upcoming_payment2" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"
        android:layout_marginTop="6dp" android:background="@drawable/widget_panel_dark"
        android:paddingHorizontal="10dp" android:text="" android:textColor="#94A3B8"
        android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
