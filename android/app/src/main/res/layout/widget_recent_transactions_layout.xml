<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_recent_tx_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_surface_dark"
    android:padding="16dp">

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:id="@+id/widget_recent_icon_panel"
            android:background="@drawable/widget_panel_dark"
            android:gravity="center"
            android:layout_marginEnd="10dp">
            <ImageView
                android:id="@+id/widget_recent_tx_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_card" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_recent_tx1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sin movimientos"
                android:textColor="#F8FAFC"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/widget_recent_tx1_meta" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="" android:textColor="#94A3B8"
                android:textSize="9sp" android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_recent_tx1_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textColor="#818CF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/widget_eye_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="5dp"
            android:src="@drawable/ic_widget_eye" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_recent_tx2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="12sp" />
            <TextView android:id="@+id/widget_recent_tx2_meta" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="" android:textColor="#64748B"
                android:textSize="9sp" android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_recent_tx2_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#818CF8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ver todos los movimientos"
            android:textColor="#818CF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#818CF8"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
