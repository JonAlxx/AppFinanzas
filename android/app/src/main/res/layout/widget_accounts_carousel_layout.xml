<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_accounts_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#4F46E5"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Top Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_account_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cuenta Principal"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_account_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Débito"
            android:textColor="#C7D2FE"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Card Number -->
    <TextView
        android:id="@+id/widget_card_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="**** **** **** 0000"
        android:textColor="#E0E7FF"
        android:textSize="12sp"
        android:layout_marginTop="8dp" />

    <!-- Bottom Row with Balance & Carousel Navigation Arrows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saldo disponible"
                android:textColor="#C7D2FE"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_account_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Navigation Buttons (< and >) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_btn_prev_card"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="#3730A3"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_card_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/1"
                android:textColor="#E0E7FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_btn_next_card"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="#3730A3"
                android:text="›"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
