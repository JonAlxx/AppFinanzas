<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_accounts_container"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:background="@drawable/widget_card_indigo" android:padding="15dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_account_icon" android:layout_width="30dp"
            android:layout_height="30dp" android:background="@drawable/widget_glass_button"
            android:text="💳" android:textSize="14sp" android:gravity="center" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="9dp">
            <TextView android:id="@+id/widget_account_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:text="Cuenta principal" android:textColor="#FFFFFF" android:textSize="13sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/widget_account_type" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="DÉBITO" android:textColor="#CCFFFFFF"
                android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.08" />
        </LinearLayout>
        <TextView android:id="@+id/widget_account_network" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF"
            android:textStyle="bold|italic" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <TextView android:id="@+id/widget_account_balance_label" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="SALDO" android:textColor="#BFFFFFFF"
            android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.16" />
        <TextView android:id="@+id/widget_account_balance" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="$0.00" android:textColor="#FFFFFF"
            android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_card_number" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="•••• •••• •••• 0000"
            android:textColor="#D9FFFFFF" android:textSize="10sp" android:letterSpacing="0.08" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Toca la tarjeta para abrir"
            android:textColor="#A6FFFFFF" android:textSize="8sp" />
        <TextView android:id="@+id/widget_btn_prev_card" android:layout_width="28dp"
            android:layout_height="28dp" android:background="@drawable/widget_glass_button"
            android:text="‹" android:textColor="#FFFFFF" android:textSize="18sp"
            android:gravity="center" android:textStyle="bold" />
        <TextView android:id="@+id/widget_card_counter" android:layout_width="38dp"
            android:layout_height="wrap_content" android:text="1 / 1" android:textColor="#E6FFFFFF"
            android:textSize="9sp" android:textStyle="bold" android:gravity="center" />
        <TextView android:id="@+id/widget_btn_next_card" android:layout_width="28dp"
            android:layout_height="28dp" android:background="@drawable/widget_glass_button"
            android:text="›" android:textColor="#FFFFFF" android:textSize="18sp"
            android:gravity="center" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
