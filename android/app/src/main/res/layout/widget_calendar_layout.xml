<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calendar_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_surface_dark"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_calendar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📅 Calendario de Pagos"
        android:textColor="#F8FAFC"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/widget_calendar_event1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cargando eventos..."
        android:textColor="#818CF8"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_calendar_event2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#F43F5E"
        android:textSize="11sp"
        android:layout_marginTop="4dp" />
</LinearLayout>
