<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_savings_goal_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0B1120"
    android:padding="14dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_goal_percentage"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="#1E293B"
        android:text="68%"
        android:textColor="#818CF8"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_goal_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Viaje a Cancún 🌴"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_goal_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$20,450 / $30,000"
            android:textColor="#10B981"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_goal_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 Límite: 30 nov 2025"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
