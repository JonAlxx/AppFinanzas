<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
  <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false">
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="finanzasapp"/>
      </intent-filter>
    </activity>

    <!-- 1. Saldo Total -->
    <receiver
        android:name=".WidgetTotalBalanceProvider"
        android:label="Saldo Total"
        android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_total_balance_info" />
    </receiver>

    <!-- 2. Carrusel Cuentas y Tarjetas -->
    <receiver
        android:name=".WidgetAccountsCarouselProvider"
        android:label="Cuentas y Tarjetas"
        android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="com.example.finanzaspersonales.ACTION_NEXT_CARD" />
        <action android:name="com.example.finanzaspersonales.ACTION_PREV_CARD" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_accounts_carousel_info" />
    </receiver>

    <!-- 3. Presupuesto Mensual -->
    <receiver
        android:name=".WidgetMonthlyBudgetProvider"
        android:label="Presupuesto Mensual"
        android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_monthly_budget_info" />
    </receiver>

    <!-- 4. Meta de Ahorro -->
    <receiver
        android:name=".WidgetSavingsGoalProvider"
        android:label="Meta de Ahorro"
        android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_savings_goal_info" />
    </receiver>

    <!-- 5. Gastos por Categoría -->
    <receiver
        android:name=".WidgetCategoryExpensesProvider"
        android:label="Gastos por Categoría"
        android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_category_expenses_info" />
    </receiver>

    <!-- 6. Pagos y Recordatorios -->
    <receiver
        android:name=".WidgetUpcomingPaymentsProvider"
        android:label="Pagos y Recordatorios"
        android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_upcoming_payments_info" />
    </receiver>

    <!-- 7. Movimientos Recientes -->
    <receiver
        android:name=".WidgetRecentTransactionsProvider"
        android:label="Movimientos Recientes"
        android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_recent_transactions_info" />
    </receiver>

    <!-- 8. Calendario de Pagos -->
    <receiver
        android:name=".WidgetCalendarProvider"
        android:label="Calendario de Pagos"
        android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_calendar_info" />
    </receiver>

    <!-- 9. Gastos (Diario y Semanal) + Botón Registrar -->
    <receiver
        android:name=".WidgetExpensesProvider"
        android:label="Gastos (Diario y Semanal)"
        android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_expenses_info" />
    </receiver>
    <!-- Reusable RemoteViews Service for Scrollable Lists (Transactions, Accounts, Budgets, Payments) -->
    <service
        android:name=".WidgetListService"
        android:permission="android.permission.BIND_REMOTEVIEWS"
        android:exported="false" />

    <!-- Control_Ojo: alterna balanceHidden localmente sin abrir MainActivity -->
    <receiver
        android:name=".WidgetEyeToggleReceiver"
        android:exported="false">
      <intent-filter>
        <action android:name="com.example.finanzaspersonales.ACTION_TOGGLE_EYE" />
      </intent-filter>
    </receiver>
  </application>
</manifest>